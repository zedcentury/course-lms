<odoo>
    <data>
        <!-- explicit list view definition -->

        <record model="ir.ui.view" id="le.schedule.table.form">
            <field name="name">le.schedule.table.form</field>
            <field name="model">le.schedule.table</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="value"/>
                            <field name="value2"/>
                        </group>
                    </sheet>
                    <footer>
                        <button type="object" string="Save" class="btn-primary" special="save"/>
                        <button type="object" string="Cancel" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>


        <!-- actions opening views on models -->
        <record model="ir.actions.act_window" id="education.action_window">
            <field name="name">education window</field>
            <field name="res_model">le.schedule.table</field>
            <field name="view_mode">list,form</field>
            <field name="view_ids" eval="[Command.clear(),
                Command.create({'view_mode': 'list', 'view_id': ref('view_account_journal_tree'), 'sequence': 1}),
                Command.create({'view_mode': 'kanban', 'view_id': ref('account_journal_view_kanban')}),
                Command.create({'view_mode': 'form', 'view_id': ref('le.schedule.table.form')})]"/>
        </record>

        <!-- server action to the one above -->
