<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="refund_list" model="ir.ui.view">
            <field name="name">refund_list</field>
            <field name="model">lp.payment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="student_id"/>
                    <field name="payment_type"/>
                    <field name="amount" decoration-success="detailed_type == 'top_up_balance'" decoration-danger="detailed_type == 'refund'"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="refund_form" model="ir.ui.view">
            <field name="name">refund_form</field>
            <field name="model">lp.payment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button type="object" string="Confirm" name="action_confirm" class="btn-primary"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="student_id"/>
                                <field name="amount"/>
                                <field name="user_id"/>
                                <field name="detailed_type" invisible="1"/>
                            </group>
                            <group>
                                <field name="payment_date"/>
                                <field name="payment_type"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_payment_refund" model="ir.actions.act_window">
            <field name="name">Refund</field>
            <field name="res_model">lp.payment</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[
                ('detailed_type', '=', 'refund')
            ]</field>
            <field name="context">{
                'default_detailed_type': 'refund'
            }</field>
        </record>
    </data>
</odoo>