<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="top_up_balance_list" model="ir.ui.view">
            <field name="name">top_up_balance_list</field>
            <field name="model">lp.payment</field>
            <field name="arch" type="xml">
                <list>
                    <field name="student_id"/>
                    <field name="payment_type"/>
                    <field name="amount" decoration-success="detailed_type == 'top_up_balance'" decoration-danger="detailed_type == 'refund'"/>
                    <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'confirmed'" decoration-danger="state == 'cancelled'"/>
                </list>
            </field>
        </record>

        <record id="top_up_balance_form" model="ir.ui.view">
            <field name="name">top_up_balance_form</field>
            <field name="model">lp.payment</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button type="object" string="Confirm" name="action_confirm" class="btn-primary"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,confirmed"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="student_id"/>
                                <field name="amount"/>
                                <field name="user_id"/>
                                <field name="detailed_type" invisible="1"/>
                            </group>
                            <group>
                                <field name="payment_date"/>
                                <field name="payment_type"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="top_up_balance_pivot" model="ir.ui.view">
            <field name="name">top_up_balance_pivot</field>
            <field name="model">lp.payment</field>
            <field name="arch" type="xml">
                <pivot>
                    <field name="payment_type" type="col"/>
                    <field name="state" type="row"/>
                    <field name="amount" type="measure"/>
                </pivot>
            </field>
        </record>

        <record id="action_payment_top_up_balance" model="ir.actions.act_window">
            <field name="name">Top Up Balance</field>
            <field name="res_model">lp.payment</field>
            <field name="view_mode">list,pivot,form</field>
            <field name="domain">[
                ('detailed_type', '=', 'top_up_balance')
            ]</field>
            <field name="context">{
                'default_detailed_type': 'top_up_balance'
            }</field>
        </record>
    </data>
</odoo>