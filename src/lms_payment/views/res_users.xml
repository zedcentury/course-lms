<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_users_form" model="ir.ui.view">
            <field name="name">view_users_form</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[1]" position="inside">
                    <field name="balance"/>
                </xpath>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button class="oe_stat_button" type="object" name="action_view_balance_history" icon="fa-dollar">
                        <div class="o_field_widget o_stat_info">
                            <span class="o_stat_value">
                                <field name="balance" class="text-danger" invisible="balance >= 0"/>
                                <field name="balance" invisible="balance &lt; 0"/>
                            </span>
                            <span class="o_stat_text">Balance</span>
                        </div>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>